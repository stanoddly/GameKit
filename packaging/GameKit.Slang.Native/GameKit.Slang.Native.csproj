<Project Sdk="Microsoft.NET.Sdk">

    <!-- Parameterized project for building GameKit.Slang.Native.{rid} packages.
         Usage: dotnet pack -p:SlangRid=linux-x64 -p:Version=1.0.0
         Before packing, populate tools/bin/ and tools/lib/ with the Slang binaries for the target RID. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <NoBuild>true</NoBuild>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>true</IsPackable>
        <IncludeSymbols>false</IncludeSymbols>
        <PackageId>GameKit.Slang.Native.$(SlangRid)</PackageId>
        <Description>Slang shader compiler native binaries for $(SlangRid). Used by GameKit.SdlangCompileLib for build-time shader compilation.</Description>
    </PropertyGroup>

    <!-- Include the native tools in the package -->
    <ItemGroup>
        <None Include="tools/**/*" Pack="true" PackagePath="tools/" />
    </ItemGroup>

    <!-- Include the build targets (renamed to match PackageId for NuGet auto-import) -->
    <ItemGroup>
        <None Include="build/SlangNative.targets" Pack="true"
              PackagePath="build/GameKit.Slang.Native.$(SlangRid).targets" />
    </ItemGroup>

</Project>
