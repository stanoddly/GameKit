<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\src\Pixely.SdlangCompiler\build\Pixely.SlangBundle.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- Keep the packaging project's own output out of lib while retaining pack's build-output and symbol extension points. -->
        <TargetExt>.packaging</TargetExt>
        <DebugType>none</DebugType>
        <IsPackable>true</IsPackable>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <PackageId>Pixely</PackageId>
        <PackageVersion Condition="'$(PackageVersion)' == ''">0.0.0-alpha.local</PackageVersion>
        <Authors>stanoddly</Authors>
        <PackageDescription>Personal, highly experimental .NET game-development toolkit. APIs, architecture, and package boundaries may change without notice.</PackageDescription>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>game-development;graphics;audio;dependency-injection;experimental</PackageTags>
        <RepositoryUrl>https://github.com/stanoddly/Pixely</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CollectPixelyBuildOutputs</TargetsForTfmSpecificBuildOutput>
        <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);CollectPixelyDebugSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectSlangToolOutputs</TargetsForTfmSpecificContentInPackage>
        <BeforePack>PrepareSlangToolOutputs;$(BeforePack)</BeforePack>
        <SlangBundleIntermediateDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'slang-bundles'))</SlangBundleIntermediateDirectory>
        <SlangFullBundleDirectory>$(SlangBundleIntermediateDirectory)full/</SlangFullBundleDirectory>
        <SlangBundleStagingDirectory>$(SlangBundleIntermediateDirectory)staging/</SlangBundleStagingDirectory>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
        <PackageReference Include="ZLogger" Version="2.5.10" />
        <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" />
        <PackageReference Include="ppy.SDL3_image-CS" Version="2026.722.0" />
        <PackageReference Include="ppy.SDL3_mixer-CS" Version="2026.722.0" />
        <PackageReference Include="ppy.SDL3_ttf-CS" Version="2026.722.0" />
    </ItemGroup>

    <ItemGroup>
        <_PixelyRuntimeProject Include="..\..\src\Pixely.AStar\Pixely.AStar.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.Architecture.Testing\Pixely.Architecture.Testing.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.Architecture\Pixely.Architecture.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.Audio\Pixely.Audio.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.Collections\Pixely.Collections.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.Componentize\Pixely.Componentize.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.Core\Pixely.Core.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.DependencyInjection\Pixely.DependencyInjection.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.Events\Pixely.Events.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.Logging\Pixely.Logging.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.Pencuil\Pixely.Pencuil.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.ShaderCommon\Pixely.ShaderCommon.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely.Utils\Pixely.Utils.csproj" />
        <_PixelyRuntimeProject Include="..\..\src\Pixely\Pixely.csproj" />
        <ProjectReference Include="@(_PixelyRuntimeProject)" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.DependencyInjection.Generator\Pixely.DependencyInjection.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\..\src\Pixely.SdlangCompiler\Pixely.SdlangCompiler.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
        <None Include="..\..\src\Pixely.DependencyInjection.Generator\bin\$(Configuration)\netstandard2.0\Pixely.DependencyInjection.Generator.dll"
              Pack="true" PackagePath="analyzers\dotnet\cs" />
        <None Include="..\..\src\Pixely.SdlangCompiler\bin\$(Configuration)\net10.0\Pixely.SdlangCompiler.dll"
              Pack="true" PackagePath="tools\net10.0\any" />
        <None Include="..\..\src\Pixely.ShaderCommon\bin\$(Configuration)\net10.0\Pixely.ShaderCommon.dll"
              Pack="true" PackagePath="tools\net10.0\any" />
        <None Include="..\..\src\Pixely.SdlangCompiler\build\Pixely.SdlangCompiler.props"
              Pack="true" PackagePath="tools\net10.0\any\build" />
        <None Include="..\..\src\Pixely.SdlangCompiler\build\Pixely.SdlangCompiler.targets"
              Pack="true" PackagePath="tools\net10.0\any\build" />
        <None Include="..\..\src\Pixely.SdlangCompiler\build\Pixely.SlangBundle.props"
              Pack="true" PackagePath="tools\net10.0\any\build" />
        <None Include="buildTransitive\Pixely.props" Pack="true" PackagePath="buildTransitive" />
        <None Include="buildTransitive\Pixely.targets" Pack="true" PackagePath="buildTransitive" />
    </ItemGroup>

    <ItemGroup>
        <_SlangSourceArchive Include="@(_SlangBundleDistribution->'$(SlangFullBundleDirectory)$(SlangBundleVersion)-%(Platform).zip')" />
    </ItemGroup>

    <Target Name="PrepareSlangToolOutputs">
        <MakeDir Directories="$(SlangFullBundleDirectory);$(SlangBundleStagingDirectory)" />
        <DownloadFile SourceUrl="https://github.com/stanoddly/slang-dxc-bundle/releases/download/$(SlangBundleVersion)/%(_SlangSourceArchive.Filename)%(_SlangSourceArchive.Extension).sha256"
                      DestinationFolder="$(SlangFullBundleDirectory)"
                      DestinationFileName="%(_SlangSourceArchive.Filename)%(_SlangSourceArchive.Extension).sha256"
                      Retries="3"
                      RetryDelayMilliseconds="1000"
                      Condition="!Exists('%(_SlangSourceArchive.Identity).sha256')" />
        <GetFileHash Files="@(_SlangSourceArchive)"
                     Algorithm="SHA256"
                     Condition="Exists('%(_SlangSourceArchive.Identity)')">
            <Output TaskParameter="Items" ItemName="_SlangCachedArchiveHash" />
        </GetFileHash>
        <Delete Files="%(_SlangCachedArchiveHash.Identity)"
                Condition="'%(_SlangCachedArchiveHash.FileHash)' != '$([System.IO.File]::ReadAllText(%(_SlangCachedArchiveHash.Identity).sha256).Substring(0, 64))'" />
        <DownloadFile SourceUrl="https://github.com/stanoddly/slang-dxc-bundle/releases/download/$(SlangBundleVersion)/%(_SlangSourceArchive.Filename)%(_SlangSourceArchive.Extension)"
                      DestinationFolder="$(SlangFullBundleDirectory)"
                      DestinationFileName="%(_SlangSourceArchive.Filename)%(_SlangSourceArchive.Extension)"
                      Retries="3"
                      RetryDelayMilliseconds="1000"
                      Condition="!Exists('%(_SlangSourceArchive.Identity)')" />
        <VerifyFileHash File="%(_SlangSourceArchive.Identity)"
                        Hash="$([System.IO.File]::ReadAllText(%(_SlangSourceArchive.Identity).sha256).Substring(0, 64))"
                        Algorithm="SHA256" />
        <RemoveDir Directories="$(SlangBundleStagingDirectory)%(_SlangSourceArchive.Platform)" />
        <Unzip SourceFiles="%(_SlangSourceArchive.Identity)"
               DestinationFolder="$(SlangBundleStagingDirectory)%(_SlangSourceArchive.Platform)"
               Include="%(_SlangSourceArchive.BundleEntries)"
               SkipUnchangedFiles="false" />
        <CreateItem Include="%(_SlangBundleDistribution.RequiredFiles)">
            <Output TaskParameter="Include" ItemName="_SlangBundleRequiredFile" />
        </CreateItem>
        <ItemGroup>
            <_MissingSlangBundleRequiredFile Include="@(_SlangBundleRequiredFile)"
                                             Condition="!Exists('$(SlangBundleStagingDirectory)%(_SlangBundleRequiredFile.Identity)')" />
        </ItemGroup>
        <Error Text="Required Slang bundle files were not extracted: @(_MissingSlangBundleRequiredFile, ', ')"
               Condition="'@(_MissingSlangBundleRequiredFile)' != ''" />
        <ItemGroup>
            <ProjectReference Update="@(_PixelyRuntimeProject)">
                <AdditionalProperties>_PrepareSlangOnBuild=false;SlangToolRoot=$(SlangBundleStagingDirectory)</AdditionalProperties>
            </ProjectReference>
            <ProjectReference Update="..\..\src\Pixely.SdlangCompiler\Pixely.SdlangCompiler.csproj">
                <AdditionalProperties>_PrepareSlangOnBuild=false;SlangToolRoot=$(SlangBundleStagingDirectory)</AdditionalProperties>
            </ProjectReference>
        </ItemGroup>
    </Target>

    <Target Name="CollectSlangToolOutputs" DependsOnTargets="PrepareSlangToolOutputs" Returns="@(TfmSpecificPackageFile)">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(SlangBundleStagingDirectory)%(_SlangSourceArchive.Platform)/**/*">
                <PackagePath>tools\slang\%(_SlangSourceArchive.Platform)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
        <Touch Files="@(TfmSpecificPackageFile)" Time="2000-01-01T00:00:00Z" />
    </Target>

    <Target Name="ResolvePixelyRuntimeOutputs">
        <MSBuild Projects="@(_PixelyRuntimeProject)"
                 Targets="GetTargetPath"
                 BuildInParallel="true"
                 Properties="Configuration=$(Configuration);Version=$(Version);PackageVersion=$(PackageVersion);RepositoryCommit=$(RepositoryCommit);RepositoryBranch=$(RepositoryBranch);ContinuousIntegrationBuild=$(ContinuousIntegrationBuild)">
            <Output TaskParameter="TargetOutputs" ItemName="_PixelyRuntimeAssembly" />
        </MSBuild>
        <ItemGroup>
            <_PixelyRuntimeSymbol Include="@(_PixelyRuntimeAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
        </ItemGroup>
    </Target>

    <Target Name="CollectPixelyBuildOutputs" DependsOnTargets="ResolvePixelyRuntimeOutputs" Returns="@(BuildOutputInPackage)">
        <ItemGroup>
            <BuildOutputInPackage Include="@(_PixelyRuntimeAssembly)">
                <FinalOutputPath>%(Identity)</FinalOutputPath>
                <TargetPath>%(Filename)%(Extension)</TargetPath>
            </BuildOutputInPackage>
        </ItemGroup>
    </Target>

    <Target Name="CollectPixelyDebugSymbols" DependsOnTargets="ResolvePixelyRuntimeOutputs" Returns="@(TfmSpecificDebugSymbolsFile)">
        <ItemGroup>
            <TfmSpecificDebugSymbolsFile Include="@(_PixelyRuntimeSymbol)">
                <FinalOutputPath>%(Identity)</FinalOutputPath>
                <TargetPath>%(Filename)%(Extension)</TargetPath>
                <TargetFramework>$(TargetFramework)</TargetFramework>
            </TfmSpecificDebugSymbolsFile>
        </ItemGroup>
    </Target>

</Project>
