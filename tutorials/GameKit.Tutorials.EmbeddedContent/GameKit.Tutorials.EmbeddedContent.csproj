<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ContentSourceDirectory>$(MSBuildProjectDirectory)/Content</ContentSourceDirectory>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\GameKit\GameKit.csproj" />
        <ProjectReference Include="..\..\src\GameKit.SdlangCompileTask\GameKit.SdlangCompileTask.csproj"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Import Project="..\..\src\GameKit.SdlangCompileTask\build\GameKit.SdlangCompileTask.props" />
    <Import Project="..\..\src\GameKit.SdlangCompileTask\build\GameKit.SdlangCompileTask.targets" />

    <ItemGroup>
        <SdlangShader Include="Content\shaders\**\*.slang" />
    </ItemGroup>

    <!-- Generated files do not exist during project evaluation. Compile them before MSBuild assigns
         resource paths, while publishing without a build reuses the resources in the existing assembly. -->
    <Target Name="EmbedShaderOutputs"
            BeforeTargets="AssignTargetPaths"
            DependsOnTargets="CompileSdlangShaders"
            Condition="'$(NoBuild)' != 'true'">
        <ItemGroup>
            <_ShaderResource Include="@(SdlangShaderOutput)">
                <ContentRelativePath>$([MSBuild]::MakeRelative('$(ContentSourceDirectory)', '%(FullPath)'))</ContentRelativePath>
            </_ShaderResource>
            <EmbeddedResource Include="@(_ShaderResource)">
                <WithCulture>false</WithCulture>
                <LogicalName>$([System.String]::Copy('%(ContentRelativePath)').Replace('\', '/'))</LogicalName>
            </EmbeddedResource>
        </ItemGroup>
    </Target>

</Project>
