<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <!-- Standalone tool: it ships the Slang distribution next to its own binaries -->
        <CopySlangToOutput>true</CopySlangToOutput>
    </PropertyGroup>

    <Import Project="..\GameKit.SdlangCompileLib\build\GameKit.SdlangCompileLib.props" />
    <Import Project="..\GameKit.SdlangCompileLib\build\GameKit.SdlangCompileLib.targets" />

    <ItemGroup>
      <PackageReference Include="System.CommandLine" Version="2.0.10" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\GameKit.SdlangCompileLib\GameKit.SdlangCompileLib.csproj" />
    </ItemGroup>

</Project>
