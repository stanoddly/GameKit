<Project>
    <PropertyGroup>
        <SlangPlatform Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">linux-x86_64</SlangPlatform>
        <SlangPlatform Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-aarch64</SlangPlatform>
        <SlangPlatform Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">windows-x86_64</SlangPlatform>
        <SlangPlatform Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">macos-x86_64</SlangPlatform>
        <SlangPlatform Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">macos-aarch64</SlangPlatform>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)Pixely.SlangBundle.props" />

    <PropertyGroup>
        <SlangDirName Condition="'$(SlangDirName)' == ''">$(SlangBundleVersion)-$(SlangPlatform)</SlangDirName>
        <SlangObjDir Condition="'$(SlangObjDir)' == ''">$(MSBuildThisFileDirectory)../obj/</SlangObjDir>
        <SlangToolSourceDirectory Condition="'$(SlangToolSourceDirectory)' == '' and '$(SlangToolRoot)' != '' and '$(SlangPlatform)' != ''">$(SlangToolRoot)$(SlangPlatform)/</SlangToolSourceDirectory>
        <SlangBaseDir Condition="'$(SlangBaseDir)' == '' and '$(SlangToolSourceDirectory)' != ''">$(SlangToolSourceDirectory)</SlangBaseDir>
        <SlangBaseDir Condition="'$(SlangBaseDir)' == ''">$(SlangObjDir)$(SlangDirName)</SlangBaseDir>
        <SlangBinDir Condition="'$(SlangBinDir)' == ''">$(SlangBaseDir)/bin</SlangBinDir>
        <SlangCompilerExeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">slangc.exe</SlangCompilerExeName>
        <SlangCompilerExeName Condition="'$(SlangCompilerExeName)' == ''">slangc</SlangCompilerExeName>
        <SlangCompilerPath Condition="'$(SlangCompilerPath)' == ''">$(SlangBinDir)/$(SlangCompilerExeName)</SlangCompilerPath>
        <SdlangCompilerAssembly Condition="'$(SdlangCompilerAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\Pixely.SdlangCompiler.dll')">$(MSBuildThisFileDirectory)..\lib\$(TargetFramework)\Pixely.SdlangCompiler.dll</SdlangCompilerAssembly>
        <SdlangCompilerAssembly Condition="'$(SdlangCompilerAssembly)' == ''">$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(TargetFramework)\Pixely.SdlangCompiler.dll</SdlangCompilerAssembly>
    </PropertyGroup>
</Project>
