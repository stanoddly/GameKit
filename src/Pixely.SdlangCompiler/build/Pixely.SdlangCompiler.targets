<Project>
    <UsingTask
        TaskName="Pixely.SdlangCompiler.SdlangCompileTask"
        AssemblyFile="$(SdlangCompilerAssembly)"
        TaskFactory="TaskHostFactory"
        Runtime="NET" />

    <Target Name="ValidateSlangPlatform" BeforeTargets="DownloadSlang">
        <Error Text="Unsupported platform for Slang shader compiler. Supported: Linux x64, Linux ARM64, Windows x64, macOS x64, macOS ARM64."
               Condition="'$(SlangPlatform)' == ''" />
    </Target>

    <Target Name="DownloadSlang" BeforeTargets="BeforeBuild"
            Condition="'$(_OwnsSlangInstallation)' == 'true'">
        <Message Text="Downloading Slang from $(SlangDownloadUrl)..." Importance="high" Condition="!Exists('$(SlangZipPath)')" />
        <DownloadFile SourceUrl="$(SlangDownloadUrl)"
                      DestinationFolder="$(SlangObjDir)"
                      DestinationFileName="$(SlangZipFile)"
                      Retries="3"
                      RetryDelayMilliseconds="1000"
                      Condition="!Exists('$(SlangZipPath)')" />
        <Error Text="Slang download failed: $(SlangZipPath) does not exist. Check network connectivity and the download URL."
               Condition="!Exists('$(SlangZipPath)')" />
    </Target>

    <Target Name="ExtractSlang" AfterTargets="DownloadSlang" BeforeTargets="BeforeBuild"
            Condition="'$(_OwnsSlangInstallation)' == 'true'">
        <PropertyGroup>
            <NeedsExtraction Condition="!Exists('$(SlangBinDir)')">true</NeedsExtraction>
        </PropertyGroup>

        <Message Text="Extracting Slang to $(SlangBaseDir)..." Importance="high" Condition="'$(NeedsExtraction)' == 'true'" />
        <Unzip SourceFiles="$(SlangZipPath)"
               DestinationFolder="$(SlangBaseDir)"
               Condition="'$(NeedsExtraction)' == 'true'" />
        <RemoveDir Directories="$(SlangBaseDir)/include;$(SlangBaseDir)/share;$(SlangBaseDir)/lib/cmake"
                   Condition="'$(NeedsExtraction)' == 'true'" />
        <Delete Files="$(SlangBaseDir)/LICENSE;$(SlangBaseDir)/README.md"
                Condition="'$(NeedsExtraction)' == 'true'" />
        <Message Text="Slang extracted and cleaned up at $(SlangBaseDir)" Importance="high" Condition="'$(NeedsExtraction)' == 'true'" />
    </Target>

    <Target Name="CompileSdlangShaders" BeforeTargets="CoreCompile" Condition="'@(SdlangShader)' != ''">
        <SdlangCompileTask InputFile="%(SdlangShader.Identity)" SlangCompilerPath="$(SlangCompilerPath)">
            <Output TaskParameter="GeneratedFiles" ItemName="SdlangShaderOutput" />
        </SdlangCompileTask>
    </Target>
</Project>
