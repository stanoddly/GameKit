<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" />
        <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" />
    </ItemGroup>

    <!-- Include build files in the NuGet package -->
    <ItemGroup>
        <None Include="build\**" Pack="true" PackagePath="build\" />
    </ItemGroup>

    <!-- For project references, import the props and targets files directly -->
    <ItemGroup>
        <None Include="build\GameKit.SdlangCompileTask.props" Link="GameKit.SdlangCompileTask.props" />
        <None Include="build\GameKit.SdlangCompileTask.targets" Link="GameKit.SdlangCompileTask.targets" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\GameKit.SdlangCompileLib\GameKit.SdlangCompileLib.csproj" />
    </ItemGroup>

</Project>
