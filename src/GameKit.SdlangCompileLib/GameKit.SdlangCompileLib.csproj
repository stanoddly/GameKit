<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed;IlcOptimizationPreference">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <!-- These files live in this project's obj directory, so only this project may create them. -->
        <OwnsSlangInstallation>true</OwnsSlangInstallation>
    </PropertyGroup>

    <!-- Slang configuration and installation. Projects that need to locate slangc import the configuration too. -->
    <Import Project="build\GameKit.SdlangCompileLib.props" />
    <Import Project="build\GameKit.SdlangCompileLib.targets" />

    <ItemGroup>
      <None Include="build\**" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\GameKit.ShaderCommon\GameKit.ShaderCommon.csproj" />
    </ItemGroup>

    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SlangVersion</_Parameter1>
        <_Parameter2>$(SlangVersion)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>

</Project>
