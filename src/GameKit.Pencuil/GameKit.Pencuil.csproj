<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);GameKit.DependencyInjection.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\GameKit.Common\GameKit.Common.csproj" />
      <ProjectReference Include="..\GameKit.Componentize\GameKit.Componentize.csproj" />
      <ProjectReference Include="..\GameKit\GameKit.csproj" />
      <ProjectReference Include="..\GameKit.RenderOrchestration\GameKit.RenderOrchestration.csproj" />
      <ProjectReference Include="..\GameKit.SdlangCompileTask\GameKit.SdlangCompileTask.csproj" />
      <ProjectReference Include="..\GameKit.DependencyInjection\GameKit.DependencyInjection.csproj" />
      <ProjectReference Include="..\GameKit.DependencyInjection.Generator\GameKit.DependencyInjection.Generator.csproj"
                        OutputItemType="Analyzer"
                        ReferenceOutputAssembly="false"
                        GlobalPropertiesToRemove="PublishAot;PublishTrimmed;TrimMode;IlcOptimizationPreference"
                        AdditionalProperties="PublishAot=false;PublishTrimmed=false" />
    </ItemGroup>

    <!-- Import the task's props and targets files -->
    <Import Project="..\GameKit.SdlangCompileTask\build\GameKit.SdlangCompileTask.props" />
    <Import Project="..\GameKit.SdlangCompileTask\build\GameKit.SdlangCompileTask.targets" />

    <!-- Compile shaders before build -->
    <Target Name="CompileSdlangShaders" BeforeTargets="CoreCompile">
        <ItemGroup>
            <SdlangShader Include="Content\shaders\*.slang" />
        </ItemGroup>
        <SdlangCompileTask InputFile="%(SdlangShader.Identity)" />
    </Target>

    <!-- Embed compiled shaders as resources with proper paths for VirtualFileSystem -->
    <ItemGroup>
        <Content Remove="Content\shaders\.generated\**\*" />
        <None Remove="Content\shaders\.generated\**\*" />
        <EmbeddedResource Include="Content\shaders\.generated\**\*">
            <WithCulture>false</WithCulture>
            <LogicalName>$([System.String]::new('%(RelativeDir)%(Filename)%(Extension)').Replace('Content/shaders/.generated/','shaders/.generated/').Replace('\','/'))</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
