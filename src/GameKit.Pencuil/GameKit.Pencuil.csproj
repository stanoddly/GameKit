<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);GameKit.DependencyInjection.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GameKit.Tests" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\GameKit.Core\GameKit.Core.csproj" />
      <ProjectReference Include="..\GameKit.Componentize\GameKit.Componentize.csproj" />
      <ProjectReference Include="..\GameKit\GameKit.csproj" />
      <ProjectReference Include="..\GameKit.RenderOrchestration\GameKit.RenderOrchestration.csproj" />
      <ProjectReference Include="..\GameKit.SdlangCompileTask\GameKit.SdlangCompileTask.csproj" ReferenceOutputAssembly="false" />
      <ProjectReference Include="..\GameKit.DependencyInjection\GameKit.DependencyInjection.csproj" />
      <ProjectReference Include="..\GameKit.DependencyInjection.Generator\GameKit.DependencyInjection.Generator.csproj"
                        OutputItemType="Analyzer"
                        ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- Import the task's props and targets files -->
    <Import Project="..\GameKit.SdlangCompileTask\build\GameKit.SdlangCompileTask.props" />
    <Import Project="..\GameKit.SdlangCompileTask\build\GameKit.SdlangCompileTask.targets" />

    <!-- Compile shaders before build -->
    <ItemGroup>
        <SdlangShader Include="Content\shaders\*.slang">
            <OutputItemType>EmbeddedResource</OutputItemType>
            <OutputLogicalNamePrefix>shaders/.generated/</OutputLogicalNamePrefix>
        </SdlangShader>
    </ItemGroup>

</Project>
