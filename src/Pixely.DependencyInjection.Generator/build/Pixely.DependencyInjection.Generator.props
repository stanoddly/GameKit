  <!-- Declares PixelyDIEmitTrimAnnotations as visible to the source generator via AnalyzerConfigOptions.
       Set to 'false' to suppress [DynamicallyAccessedMembers] on generated registration methods. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="PixelyDIEmitTrimAnnotations" />
  </ItemGroup>
</Project>
