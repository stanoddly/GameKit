<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1"/>
        <PackageReference Include="NUnit" Version="4.2.2"/>
        <PackageReference Include="NUnit.Analyzers" Version="4.3.0"/>
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework"/>
    </ItemGroup>

    <!-- Copy shader files to output directory -->
    <ItemGroup>
        <Content Include="TestShaders\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Reference the SdlangCompileTask project -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\GameKit.SdlangCompileTask\GameKit.SdlangCompileTask.csproj" />
    </ItemGroup>

    <!-- Import the task's props and targets files -->
    <!-- This is not required when referencing a file from nuget -->
    <Import Project="..\..\src\GameKit.SdlangCompileTask\build\GameKit.SdlangCompileTask.props" />
    <Import Project="..\..\src\GameKit.SdlangCompileTask\build\GameKit.SdlangCompileTask.targets" />

    <!-- Unlike other projects that compile shaders BeforeTargets="CoreCompile" to embed them as
         resources, this target compiles from $(OutputPath) where test shaders are copied to,
         so it must run after CopyFilesToOutputDirectory. -->
    <Target Name="CompileSdlangShaders" AfterTargets="CopyFilesToOutputDirectory">
        <!-- Define shaders to compile -->
        <ItemGroup>
            <SdlangShader Include="$(OutputPath)\TestShaders\*.slang" />
        </ItemGroup>
        <SdlangCompileTask InputFile="%(SdlangShader.Identity)" />
    </Target>

    <!-- Test that builds succeed when no shaders match the glob pattern (issue #71) -->
    <Target Name="CompileEmptySdlangShaders" BeforeTargets="CoreCompile">
        <ItemGroup>
            <EmptySdlangShader Include="Content\empty\*.slang" />
        </ItemGroup>
        <SdlangCompileTask InputFile="%(EmptySdlangShader.Identity)" />
    </Target>
</Project>
