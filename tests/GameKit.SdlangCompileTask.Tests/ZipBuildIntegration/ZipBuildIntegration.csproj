<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPublishable>true</IsPublishable>
        <ContentSourceDirectory>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Content'))</ContentSourceDirectory>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\GameKit.SdlangCompileTask\GameKit.SdlangCompileTask.csproj"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Import Project="..\..\..\src\GameKit.SdlangCompileTask\build\GameKit.SdlangCompileTask.props" />
    <Import Project="..\..\..\src\GameKit.SdlangCompileTask\build\GameKit.SdlangCompileTask.targets" />

    <ItemGroup>
        <SdlangShader Include="Content\shaders\zip_output.slang" />
    </ItemGroup>

    <Target Name="PackageContent"
            AfterTargets="Publish">
        <ZipDirectory SourceDirectory="$(ContentSourceDirectory)"
                      DestinationFile="$(PublishDir)Content.pk3"
                      Overwrite="true" />
    </Target>

    <Target Name="RejectUnexpectedShaderCompilation"
            BeforeTargets="CompileSdlangShaders"
            Condition="'$(RejectUnexpectedShaderCompilation)' == 'true'">
        <Error Text="Shader compilation was not expected for this build." />
    </Target>

</Project>
